generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  role      String    @default("client") // "client" або "admin"
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  roomId    String   // ID клієнта є ID кімнати
  createdAt DateTime @default(now())
}